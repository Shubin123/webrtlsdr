{
  "name": "@jtarrio/webrtlsdr",
  "description": "Access RTL-SDR devices and receive and demodulate radio signals from your web application",
  "version": "3.0.7",
  "author": "Jacobo Tarrio <jtarrio@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtarrio/webrtlsdr.git"
  },
  "exports": {
    "./*.js": "./dist/*.js"
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "rm -fR dist/ && tsc",
    "build:fl2k": "node scripts/build-fl2k.mjs",
    "build:site": "npm run build && npm run build:fl2k && node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "build:iwa": "node scripts/build-iwa.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "wbn": "^0.0.9",
    "wbn-sign": "^0.3.3"
  },
  "dependencies": {
    "@jtarrio/signals": "^0.10.2",
    "@types/w3c-web-usb": "^1.0.10"
  }
}
